[Unit]
Description=WhatsApp Sender (Baileys)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/telegram-price-monitor/whatsapp-sender
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
